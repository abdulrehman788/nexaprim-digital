# Site
NEXT_PUBLIC_SITE_URL=https://expandova.com

# Database (SQLite for local: file lives at prisma/dev.db; use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Admin dashboard (required in production — use long random values, never commit real secrets)
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional extra hosts for CSRF allowlist (comma-separated), e.g. www or staging:
# ALLOWED_ORIGINS=https://www.expandova.com,https://staging.expandova.com

# Contact form — inbox for submissions (defaults to info@expandova.com via site config)
CONTACT_TO_EMAIL=info@expandova.com
# Optional custom webhook instead of FormSubmit:
# CONTACT_FORM_ENDPOINT=https://your-form-handler.example/webhook
# CONTACT_FORM_API_KEY=

# Free consultation booking (Cal.com or Calendly — instant calendar confirmation)
# NEXT_PUBLIC_BOOKING_PROVIDER=calcom
# NEXT_PUBLIC_BOOKING_URL=nexaprime-digital/consultation
# Calendly example:
# NEXT_PUBLIC_BOOKING_PROVIDER=calendly
# NEXT_PUBLIC_BOOKING_URL=your-team/20min

# Analytics (optional — production Web Vitals reporting endpoint)
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://your-analytics-endpoint.example/vitals
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Payments — mock is local-only; production must set a real gateway (mock is rejected)
# PAYMENT_GATEWAY=mock
# Required in production for /api/payments/webhook (header: x-webhook-secret or Bearer)
# PAYMENT_WEBHOOK_SECRET=replace-with-long-random-secret
# When you add Stripe later:
# PAYMENT_GATEWAY=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
