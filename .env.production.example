# =============================================================================
# Production environment for VPS (copy to /var/www/expandova/.env and fill in)
# NEVER commit real secrets. chmod 600 .env on the server.
# =============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public site URL — must match the domain users open (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://expandova.com

# If you also serve www, list it here (comma-separated)
ALLOWED_ORIGINS=https://www.expandova.com

# SQLite on a persistent disk path (Docker volume or /var/www/.../data)
# For Docker Compose this path is inside the container:
DATABASE_URL="file:/app/data/prod.db"

# Admin (required — 12+ char password, 32+ char session secret)
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Contact inbox
CONTACT_TO_EMAIL=info@expandova.com

# Booking (optional)
# NEXT_PUBLIC_BOOKING_PROVIDER=calcom
# NEXT_PUBLIC_BOOKING_URL=your-org/consultation

# Payments — leave unset / do not use mock in production until a real gateway is wired
# PAYMENT_GATEWAY=stripe
# PAYMENT_WEBHOOK_SECRET=replace-with-long-random-secret
